{
  "name": "shadow-trader-mobile",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "842901",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "842904",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "842916",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}